[Desktop Entry]
Name=I9VANDO Suporte Remoto
GenericName=Acesso Remoto
Comment=Suporte remoto seguro da I9VANDO
Exec=rustdesk %u
Icon=rustdesk
Terminal=false
Type=Application
StartupNotify=true
Categories=Network;RemoteAccess;GTK;
Keywords=internet;linux;dart;rust;remote-control;p2p;teamviewer;rust-lang;rdp;remote-desktop;vnc;
Actions=new-window;
StartupWMClass=rustdesk

X-Desktop-File-Install-Version=0.23

[Desktop Action new-window]
Name=Abrir uma nova janela
Exec=rustdesk %u
